# Plantilla de variables de entorno. NUNCA se commitea el `.env` real.
#
# Aquí van los NOMBRES de lo que el sistema lee del entorno, sin un solo valor.
# `CLAUDE.md` regla 12: ningún secreto en el repositorio.
#
# Copia este fichero a `.env` y rellénalo:  cp .env.example .env

# --- Modelo -----------------------------------------------------------------
# Clave de la API de Claude. La usa `commons/llm/`, el único punto del backend que
# habla con el proveedor. Los identificadores de modelo NO van aquí: viven en
# `config/models.yaml`, que no es un secreto.
ANTHROPIC_API_KEY=

# Solo con `proveedor: claude_code` en `config/models.yaml` (TO-040), y solo si hace falta:
# ruta del binario nativo del CLI de Claude Code. Sin ella se busca `claude` en el PATH y,
# si es el envoltorio `.cmd` de npm, el `claude.exe` que envuelve. No es un secreto.
STORYMAKER_CLAUDE_CODE=

# --- Observabilidad ---------------------------------------------------------
# Langfuse: trazas, spans y scores. `CLAUDE.md` regla 13 exige un span por rol y por
# tool, así que sin estas tres el sistema arranca pero no deja rastro.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Persistencia -----------------------------------------------------------
# Ruta del único fichero SQLite. No es un secreto; está aquí porque la demo y el
# desarrollo no deben escribir en la misma base.
STORYMAKER_DB_PATH=

# --- Validación visual y export --------------------------------------------
# Servidor Playwright MCP que usa el gate para `render_visual` y para `page.pdf()`.
PLAYWRIGHT_MCP_URL=

# --- Entorno ----------------------------------------------------------------
# `dev` | `demo` | `ci`. Decide de dónde se leen los prompts y si la sincronización
# con Langfuse se exige antes de un eval.
STORYMAKER_ENV=

# --- Lectura -----------------------------------------------------------------
# URL base del frontend donde vive la página `lectura` (spec § 4.4, CL-01). `render_visual` y
# el export la abren en `/novelas/{novel_id}/versiones/{version}` sobre esta base.
STORYMAKER_LECTURA_URL=
